# Reps Club — copie para .env.local e preencha com o seu projeto Supabase.
# Painel do Supabase → Project Settings → API.

# URL do projeto. Ex.: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (sb_publishable_...). Vai para o navegador — é seguro expor,
# porque o RLS do banco é quem decide o que ela enxerga.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origem pública do site, usada para montar os links que vão nos e-mails do
# Supabase (confirmação de conta, recuperação de senha, link mágico do aluno).
#
# Em desenvolvimento pode ficar vazia: o app deduz dos cabeçalhos da requisição.
# Em Vercel ou qualquer host com CDN na frente, PREENCHA — sem isso o link do
# e-mail aponta para o host errado e o usuário cai fora do app.
# Ex.: https://reps-club.vercel.app  (sem barra no fim)
NEXT_PUBLIC_SITE_URL=

# NÃO existe mais chave de serviço aqui, de propósito.
#
# A leitura do convite sem sessão (/convite/[token]) passa pela função
# `convite_por_token`, que devolve três campos de um convite pendente e nada
# mais. A chave de serviço ignoraria o RLS do banco inteiro: se vazasse do
# ambiente, seria acesso total a todos os alunos de todos os personais.
