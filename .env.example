# Reps Club — copie para .env.local e preencha com o seu projeto Supabase.
# Painel do Supabase → Project Settings → API.

# URL do projeto. Ex.: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (sb_publishable_...). Vai para o navegador — é seguro expor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave de serviço (sb_secret_... / service_role). SÓ NO SERVIDOR, nunca com prefixo
# NEXT_PUBLIC_. Ignora o RLS. Necessária a partir da fase 1, para ler o convite
# em /convite/[token], quando o visitante ainda não tem sessão.
SUPABASE_SECRET_KEY=
